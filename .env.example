# ─── Database ───────────────────────────────────────────────
# The app talks to its own /api backend, which uses libSQL/SQLite.
# Choose ONE of the following:
#
# 1) Local SQLite file (default — nothing to set, uses ./data/local.db)
# DATABASE_URL=file:./data/local.db
#
# 2) Turso (hosted libSQL)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# ─── Auth ───────────────────────────────────────────────────
# Secret used to sign JWT session tokens. Set a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: seed a super_admin on `npm run db:setup`
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your-strong-password

# ─── AI (optional) ──────────────────────────────────────────
VITE_OPENAI_API_KEY=
